# URL do back-end Spring Boot (só o servidor Next enxerga isto)
BACKEND_URL=http://localhost:8080
# URL do próprio Next, usada pelos Server Components para chamar o BFF via fetch
BFF_INTERNAL_URL=http://localhost:3000
# Segredo para assinar o JWT do cookie (mínimo 32 caracteres)
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
